.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(94, 174, 255);
}

GridBackground
{
    --grid-background-color: #2b2b2b;
    --line-color: rgba(51,51,51,8);
    --thick-line-color: rgba(51,51,51,1);
    --spacing: 25;
}

.ng-node {
    min-width: 210px;
    background-color: #16191f;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(91, 110, 132, 0.95);
    border-bottom-color: rgba(5, 7, 10, 0.95);
    border-left-color: rgba(53, 64, 78, 0.95);
    border-right-color: rgba(5, 7, 10, 0.95);
}

.ng-node-debug {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: #00ff00;
    border-bottom-color: #00ff00;
    border-left-color: #00ff00;
    border-right-color: #00ff00;
}

.ng-node-main {
    flex-grow: 1;
    background-color: #171b22;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.ng-node-title {
    min-height: 34px;
    padding-left: 0;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    flex-direction: row;
    align-items: stretch;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(91, 180, 255, 0.55);
}

.ng-node-title-accent {
    width: 7px;
    min-width: 7px;
    margin-right: 7px;
    border-top-left-radius: 7px;
}

.ng-node-title-field {
    flex-grow: 1;
    min-height: 26px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
    margin-bottom: 4px;
    color: #eef7ff;
    -unity-font-style: bold;
}

.ng-node-title-field > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.18);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(0, 0, 0, 0.3);
    color: #eef7ff;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ng-node-port-row {
    min-height: 38px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 7px;
    padding-bottom: 6px;
    background-color: #11151b;
    border-bottom-width: 1px;
    border-bottom-color: rgba(70, 82, 96, 0.65);
}

.ng-node-inputs,
.ng-node-outputs {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 24px;
}

.ng-node-inputs {
    align-items: flex-start;
}

.ng-node-outputs {
    align-items: flex-end;
}

.ng-port-wrapper {
    width: 100%;
    min-height: 22px;
}

.ng-port-wrapper-input {
    justify-content: flex-start;
}

.ng-port-wrapper-output {
    justify-content: flex-end;
}

.ng-node-inputs .port,
.ng-node-outputs .port {
    min-height: 22px;
    margin-top: 1px;
    margin-bottom: 1px;
    color: #d8e0ea;
    font-size: 11px;
}

.ng-port-input {
    color: #f0c674;
    flex-direction: row;
    margin-left: 0;
    padding-left: 16px;
}

.ng-port-output {
    color: #73d7ff;
    flex-direction: row;
    margin-right: 0;
    padding-right: 16px;
}

.ng-port-input > .port-label,
.ng-port-output > .port-label {
    flex-grow: 0;
    flex-shrink: 0;
}

.ng-port-wrapper-input > .ng-port-input {
    justify-content: flex-start;
}

.ng-port-wrapper-output > .ng-port-output {
    justify-content: flex-end;
}

.ng-port-input > .connector {
    background-color: #d99829;
    border-top-color: #ffd38a;
    border-bottom-color: #8f5c13;
    border-left-color: #ffd38a;
    border-right-color: #8f5c13;
}

.ng-port-output > .connector {
    background-color: #2d9fd6;
    border-top-color: #9fe8ff;
    border-bottom-color: #09658d;
    border-left-color: #9fe8ff;
    border-right-color: #09658d;
}

.node-id-label {
    flex-grow: 1;
    height: 19px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgba(182, 195, 210, 0.72);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.node-id-row {
    height: 19px;
    flex-direction: row;
    align-items: center;
    background-color: #0f1217;
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 72, 86, 0.75);
}

.node-id-copy-button {
    width: 54px;
    min-width: 54px;
    min-height: 0;
    height: 80%;
    max-height: 80%;
    margin-right: 3px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(220, 235, 248, 0.9);
    font-size: 9px;
}

.extension-container {
    flex-grow: 1;
    min-height: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 10px;
    background-color: #1b2028;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.extension-container TextField {
    margin-top: 3px;
    margin-bottom: 6px;
    color: #d7dee8;
}

.extension-container TextField > .unity-label {
    color: rgba(177, 192, 210, 0.9);
    font-size: 11px;
}

.extension-container TextField > .unity-text-field__input {
    background-color: #11151b;
    color: #edf3fb;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(77, 92, 109, 0.9);
    border-bottom-color: rgba(7, 9, 12, 0.95);
    border-left-color: rgba(77, 92, 109, 0.9);
    border-right-color: rgba(7, 9, 12, 0.95);
}

.resize-handle
{
    position: absolute;
}

.resize-handle-left,
.resize-handle-right
{
    cursor: resize-horizontal;
}

.resize-handle-top,
.resize-handle-bottom
{
    cursor: resize-vertical;
}

.resize-handle-top-left,
.resize-handle-bottom-right
{
    cursor: resize-up-left;
}

.resize-handle-top-right,
.resize-handle-bottom-left
{
    cursor: resize-up-right;
}
